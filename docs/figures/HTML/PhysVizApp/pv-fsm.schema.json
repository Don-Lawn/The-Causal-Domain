{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhysViz FSM Definition",
  "type": "object",
  "required": ["name", "initialState", "states", "events", "transitions"],
  "properties": {
    "name": {
      "type": "string"
    },
    "initialState": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "function"]
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "function"]
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "field", "value"],
        "properties": {
          "state": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "emit": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "nextState": {
            "type": "string"
          }
        }
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
